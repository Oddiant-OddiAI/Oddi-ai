# Memory-only template: merge these lines into your existing .env.
# Provider keys stay server-side.
GROQ_MEMORY_API_KEY=
OPENROUTER_MEMORY_API_KEY=
GROQ_MEMORY_MODEL=openai/gpt-oss-20b
OPENROUTER_MEMORY_MODEL=liquid/lfm-2.5-2.6b:free

# Optional password-recovery email. Configure these to enable emailed reset links.
# Production must use the canonical HTTPS app origin to prevent unsafe reset links.
ODDI_PUBLIC_BASE_URL=https://your-oddi-domain.example
ODDI_SMTP_HOST=
ODDI_SMTP_PORT=587
ODDI_SMTP_FROM=
ODDI_SMTP_USER=
ODDI_SMTP_PASSWORD=
ODDI_SMTP_USE_SSL=false
ODDI_SMTP_STARTTLS=true

# ODDI text provider Gemini keys:
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
